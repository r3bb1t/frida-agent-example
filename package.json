{
  "name": "frida-agent-example",
  "version": "1.0.0",
  "description": "Collection of useful Frida scripts",
  "private": true,
  "main": "agent/index.ts",
  "scripts": {
    "prepare": "npm run build",
    "build": "frida-compile agent/index.ts -o _agent.js -c",
    "watch": "frida-compile agent/index.ts -o _agent.js -w"
  },
  "devDependencies": {
    "@types/frida-gum": "^19.13.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.15.0",
    "frida-compile": "^19.1.0"
  },
  "trustedDependencies": [
    "frida"
  ]
}
