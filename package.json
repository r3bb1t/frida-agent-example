{
  "name": "frida-agent-example",
  "version": "1.0.0",
  "description": "Frida agent that records drcov basic-block coverage",
  "private": true,
  "main": "agent/index.ts",
  "scripts": {
    "prepare": "npm run build",
    "build": "frida-compile agent/index.ts -o _agent.js -c",
    "watch": "frida-compile agent/index.ts -o _agent.js -w",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/frida-gum": "^19.13.0",
    "eslint": "^10.15.0",
    "frida-compile": "^19.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "trustedDependencies": [
    "frida"
  ]
}
